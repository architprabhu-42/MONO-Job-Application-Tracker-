# MongoDB connection string
#   Local:  mongodb://127.0.0.1:27017/mono
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mono?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mono

PORT=5000

# Frontend origin(s) allowed by CORS (comma-separated for several)
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Secret used to sign login tokens. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Resume storage: "local" saves PDFs in UPLOAD_DIR, "gridfs" saves them inside MongoDB
# (use gridfs on hosts with an ephemeral filesystem such as Render's free tier)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Auth cookie SameSite policy: "lax" when the frontend and API share an origin,
# "none" when the frontend calls the API on a different domain directly.
COOKIE_SAMESITE=lax
